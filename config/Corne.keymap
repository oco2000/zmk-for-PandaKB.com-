#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define MAIN 0
#define LOW  1
#define HIGH 2
#define TRI  3
#define FUN  4

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <LOW HIGH>;
            then-layer = <TRI>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB         &kp Q               &kp W             &kp E           &kp R           &kp T          &kp Y    &kp U            &kp I       &kp O              &kp P                   &kp BSPC
&mt LCTRL CAPS  &mt LEFT_CONTROL A  &mt LEFT_SHIFT S  &mt LEFT_GUI D  &mt LEFT_ALT F  &kp G          &kp H    &mt RIGHT_ALT J  &mt RGUI K  &mt RIGHT_SHIFT L  &mt RIGHT_CONTROL SEMI  &kp SQT
&kp LSHFT       &kp Z               &kp X             &kp C           &kp V           &kp B          &kp N    &kp M            &kp COMMA   &kp DOT            &kp FSLH                &kp ESC
                                                      &kp LGUI        &mo LOW         &lt FUN SPACE  &kp RET  &mo HIGH         &kp RALT
            >;

            display-name = "MAIN";
        };

        lower_layer {
            bindings = <
&kp TAB    &trans  &kp HOME  &kp UP          &kp PAGE_UP    &trans      &trans   &kp N7        &kp N8        &kp N9        &kp N0  &kp BSPC
&trans     &trans  &kp LEFT  &kp DOWN        &kp RIGHT      &kp INSERT  &trans   &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &trans  &trans
&kp LSHFT  &trans  &kp END   &kp DOWN_ARROW  &kp PAGE_DOWN  &kp DELETE  &trans   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans
                             &kp LGUI        &trans         &kp SPACE   &kp RET  &trans        &kp NUMBER_0
            >;

            display-name = "LOW";
        };

        raise_layer {
            bindings = <
&kp TAB    &kp EXCL  &kp AT        &kp HASH  &kp DLLR       &kp PRCNT  &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &trans    &kp LC(LEFT)  &trans    &kp LC(RIGHT)  &trans     &kp MINUS  &kp EQUAL  &kp LBKT         &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &trans    &trans        &trans    &trans         &trans     &kp UNDER  &kp PLUS   &kp LBRC         &kp RBRC  &kp PIPE  &kp TILDE
                                   &kp LGUI  &trans         &kp SPACE  &kp RET    &trans     &kp RALT
            >;

            display-name = "HIGH";
        };

        tri_layer {
            bindings = <
&kp TAB     &sys_reset       &bootloader      &trans           &trans             &trans        &trans   &trans           &trans    &trans  &trans  &kp BSPC
&bt BT_CLR  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3       &bt BT_SEL 4  &trans   &kp PRINTSCREEN  &trans    &trans  &trans  &trans
&kp LSHFT   &rgb_ug RGB_BRD  &rgb_ug RGB_TOG  &rgb_ug RGB_BRI  &ext_power EP_TOG  &trans        &trans   &trans           &trans    &trans  &trans  &trans
                                              &kp LGUI         &trans             &trans        &kp RET  &trans           &kp RALT
            >;

            display-name = "TRI";
        };

        fun_layer {
            bindings = <
&kp TAB    &kp F1  &kp F2  &kp F3    &kp F4  &kp F5  &kp F6   &kp F7  &kp F8   &kp F9  &kp F10  &kp BSPC
&trans     &trans  &trans  &trans    &trans  &trans  &trans   &kp F4  &kp F5   &kp F6  &kp F11  &trans
&kp LSHFT  &trans  &trans  &trans    &trans  &trans  &trans   &kp F1  &kp F2   &kp F3  &kp F12  &trans
                           &kp LGUI  &trans  &trans  &kp RET  &trans  &kp F10
            >;

            display-name = "FUN";
        };
    };
};

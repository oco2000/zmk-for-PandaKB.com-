#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define MAIN 0
#define NAV  1
#define SYM  2
#define SYS  3
#define FUN  4
#define NUM  5

&mt {
    tapping-term-ms = <300>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <150>;
};

/ {
    underglow_indicators {
        compatible = "zmk,underglow-indicators";

        // Hue (0-360) and saturation (0-100) per layer, in layer order.
        layer-colors = <220 100>,   // MAIN: blue
                       <120 100>,   // NAV:  green
                       < 30 100>,   // SYM:  orange
                       <  0 100>,   // SYS:  red
                       <285 100>,   // FUN:  purple
                       < 55 100>;   // NUM:  yellow

        // Shown while a modifier is held on the base layer.
        mod-color = <0 0>;          // white
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        sys_layer {
            if-layers = <SYM NAV>;
            then-layer = <SYS>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | ENT |   | SPC | RSE  | ALT |

            bindings = <
&mt LC(TAB) TAB &kp Q        &mt LC(W) W       &kp E                &mt F5 R            &kp T        &kp Y          &kp U        &kp I       &mt LBKT O   &mt RBKT P           &kp BSPC
&hm LSHFT CAPS  &hm LCTRL A  &hm LSHFT S       &hm LGUI D           &hm LALT F          &kp G        &kp H          &hm RALT J   &hm RGUI K  &hm RSHFT L  &hm RCTRL SEMI  &kp SQT
&hm LCTRL ESC   &mt LC(Z) Z  &mt LS(DELETE) X  &mt LC(INSERT) C     &mt LS(INSERT)  V   &kp B        &kp N          &kp M        &kp COMMA   &kp DOT      &kp FSLH        &kp ESC
                                               &kp LGUI             &mo NAV             &lt NUM RET  &lt FUN SPACE  &mo SYM      &kp RALT
            >;

            display-name = "MAIN";
        };

        nav_layer {
            bindings = <
&trans   &trans        &kp LC(HOME)  &kp LC(UP)          &kp LC(PAGE_UP)     &kp LA(LEFT)  &trans       &kp HOME  &kp UP          &kp PAGE_UP    &trans         &trans
&trans   &trans        &kp LC(LEFT)  &kp LC(DOWN)        &kp LC(RIGHT)       &kp LA(RIGHT) &kp INSERT   &kp LEFT  &kp DOWN        &kp RIGHT      &kp RET        &kp RET
&trans   &trans        &kp LC(END)   &kp LC(DOWN)        &kp LC(PAGE_DOWN)   &kp LC(BSLH)  &kp DELETE   &kp END   &kp DOWN        &kp PAGE_DOWN  &kp RET        &trans
                                     &trans              &trans              &trans        &trans       &trans    &trans
            >;

            display-name = "NAV";
        };

        sym_layer {
            bindings = <
&kp TILDE &kp EXCL  &kp AT        &kp HASH  &kp DLLR       &kp PRCNT  &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &trans
&trans    &trans    &trans        &trans    &trans         &trans     &kp MINUS  &kp EQUAL  &kp LBKT         &kp RBKT  &kp BSLH  &kp GRAVE
&trans    &trans    &trans        &trans    &trans         &trans     &kp UNDER  &kp PLUS   &kp LBRC         &kp RBRC  &kp PIPE  &kp TILDE
                                  &trans    &trans         &trans     &trans     &trans     &trans
            >;

            display-name = "SYM";
        };

        sys_layer {
            bindings = <
&trans      &sys_reset       &bootloader      &trans           &trans             &trans           &sys_reset  &bootloader      &rgb_ug RGB_HUD   &rgb_ug RGB_HUI  &trans  &trans
&bt BT_CLR  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3       &bt BT_SEL 4     &trans      &kp PRINTSCREEN  &rgb_ug RGB_SAD   &rgb_ug RGB_SAI  &trans  &trans
&trans      &rgb_ug RGB_BRD  &rgb_ug RGB_TOG  &rgb_ug RGB_BRI  &ext_power EP_TOG  &rgb_ug RGB_EFF  &trans      &trans           &rgb_ug RGB_SPD   &rgb_ug RGB_SPI  &trans  &trans
                                              &trans           &trans             &trans           &trans      &trans           &trans
            >;

            display-name = "SYS";
        };

        fun_layer {
            bindings = <
&trans   &kp F1  &kp F2  &kp F3    &kp F4  &kp F5  &kp F6  &kp F7  &kp F8   &kp F9  &kp F10  &trans
&trans   &trans  &trans  &trans    &trans  &trans  &trans  &kp F4  &kp F5   &kp F6  &kp F11  &trans
&trans   &trans  &trans  &trans    &trans  &trans  &trans  &kp F1  &kp F2   &kp F3  &kp F12  &trans
                         &trans    &trans  &trans  &trans  &trans  &kp F10
            >;

            display-name = "FUN";
        };

        num_layer {
            bindings = <
&trans   &kp N1  &kp N2  &kp N3    &kp N4  &kp N5  &kp N6     &kp N7  &kp N8   &kp N9  &kp N0    &trans
&trans   &trans  &trans  &trans    &trans  &trans  &kp COMMA  &kp N4  &kp N5   &kp N6  &kp PLUS  &kp RET
&trans   &trans  &trans  &trans    &trans  &trans  &kp DOT    &kp N1  &kp N2   &kp N3  &kp MINUS &kp RET
                         &trans    &trans  &trans  &trans     &kp N0  &kp RET
            >;

            display-name = "NUM";
        };
    };
};
